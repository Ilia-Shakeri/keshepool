# /keshepool/.env

POSTGRES_USER=keshepool_user
POSTGRES_PASSWORD=change_me_to_a_strong_random_password
POSTGRES_DB=keshepool_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000

BOT_TOKEN=your_main_bot_token
BOT_USERNAME=keshepoolbot
WEBHOOK_URL=https://your-domain.example
WEB_APP_URL=https://your-domain.example
TETRA98_API_URL=https://tetra98.com
TETRA98_API_KEY=
TETRA98_WEBHOOK_SECRET=
TETRA98_ENABLED=false
CARD_TO_CARD_ENABLED=true
CARD_TO_CARD_NUMBER=6219861456548642
CARD_TO_CARD_HOLDER=مهدیار کریم زاده
CARD_TRANSFER_MAX_RECEIPT_BYTES=5000000
CARD_TRANSFER_ADMIN_NOTIFY_MAX_ATTEMPTS=12
CRYPTO_DEPOSIT_ADDRESS_USDT=
CRYPTO_WEBHOOK_SECRET=
# Operator-reviewed emergency fallback used only when live rate sources fail.
USDT_TO_IRR_RATE=replace_with_current_toman_rate
# Enable only after revision 009 is applied and the legacy Redis override is reviewed.
OPERATIONS_RATE_DB_ENABLED=false
ALLOW_INSECURE_DEV_AUTH=false
TELEGRAM_AUTH_MAX_AGE_SECONDS=3600
TELEGRAM_FINANCIAL_AUTH_MAX_AGE_SECONDS=300
AUTH_SESSION_EPOCH=1
TELEGRAM_AUTH_FUTURE_SKEW_SECONDS=60
TELEGRAM_INIT_DATA_MAX_BYTES=8192
TELEGRAM_WEBHOOK_MAX_BYTES=1048576
TELEGRAM_WEBHOOK_MAX_JSON_DEPTH=32
TELEGRAM_INBOX_BATCH_SIZE=20
TELEGRAM_INBOX_POLL_SECONDS=0.5
TELEGRAM_INBOX_STALE_SECONDS=300
TELEGRAM_INBOX_MAX_ATTEMPTS=8
TELEGRAM_INBOX_RETRY_SECONDS=10
USER_LAST_SEEN_WRITE_INTERVAL_SECONDS=300

ADMIN_BOT_TOKEN=your_stealth_admin_token
TELEGRAM_BOT_MODE=webhook
ADMIN_TELEGRAM_IDS=123456789,987654321
ADMIN_GROUP_CHAT_ID=-1001234567890
ADMIN_REQUIRE_GROUP_ADMIN=true
ADMIN_RBAC_ENABLED=false
ADMIN_ENV_BREAK_GLASS_ENABLED=true
ADMIN_DUAL_APPROVAL_ENABLED=false
ADMIN_DUAL_APPROVAL_WALLET_THRESHOLD_TOMAN=10000000
ADMIN_DUAL_APPROVAL_RATE_DEVIATION_PERCENT=10
ADMIN_FSM_TTL_SECONDS=3600
ADMIN_REPORT_LANGUAGE=fa

ASSET_ROOT=/app/static
PUBLIC_ASSET_BASE_URL=/static
SUPPORT_TELEGRAM_USERNAME=keshepool_support
CACHE_NAMESPACE=keshepool
CATALOG_CACHE_TTL_SECONDS=30
CATALOG_CACHE_LOCK_TTL_SECONDS=5
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_MAX_CONNECTIONS=50
REDIS_RETRY_ATTEMPTS=3
REDIS_RETRY_BACKOFF_MAX_SECONDS=1
INGRESS_SENSITIVE_MAX_IN_FLIGHT=64
INGRESS_IN_FLIGHT_TTL_SECONDS=120
# Leave blank until each provider publishes an operator-verified source CIDR contract.
TETRA98_CALLBACK_ALLOWED_CIDRS=
CRYPTO_CALLBACK_ALLOWED_CIDRS=

# Credential vault rollout is staged. Keep all write/read/finalize gates off until
# revision 012, mounted key files, dry-run backfill, verification, and rollback drills pass.
CREDENTIAL_VAULT_DUAL_WRITE_ENABLED=false
CREDENTIAL_VAULT_READ_PREFER_ENCRYPTED=false
CREDENTIAL_VAULT_LEGACY_FALLBACK_ENABLED=true
CREDENTIAL_VAULT_FINALIZE_ENABLED=false
CREDENTIAL_VAULT_ENCRYPTION_KEYS_FILE=
CREDENTIAL_VAULT_FINGERPRINT_KEY_FILE=
# Durable per-order reveal cap. Keep at or below the database hard cap of 100.
CREDENTIAL_REVEAL_MAX_PER_ORDER=5

MAIN_TELEGRAM_WEBHOOK_SECRET=your_main_webhook_secret_here
ADMIN_TELEGRAM_WEBHOOK_SECRET=your_admin_webhook_secret_here
WEBHOOK_SECRET=
ADMIN_API_KEY=a_very_long_random_string
ENABLE_INTERNAL_ADMIN_API=false
# Replace with the exact reverse-proxy address or network on the deployment host.
TRUSTED_PROXY_IPS=127.0.0.1
CSP_REPORT_ONLY=true
ENVIRONMENT=production

# Example only: deployment uses one immutable commit tag for both images and rejects this all-zero placeholder.
REGISTRY_IMAGE=registry.example.com/group/keshepool
IMAGE_TAG=0000000000000000000000000000000000000000

# Timezone for backup scheduling/logs
TZ=Asia/Tehran
BACKUP_MAX_AGE_SECONDS=28800
